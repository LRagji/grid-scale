{
  "name": "local-store",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "clean-build": "rimraf ./dist && tsc",
    "copy-files": "copyfiles ./package.json ./package-lock.json ./license.md ./dist/",
    "clean-prod": "rimraf ./dist/test ./dist/integration-tests ./dist/api-tests",
    "build": "npm run build-test && npm run clean-prod",
    "build-test": "npm run clean-build && npx tsc && npm run copy-files",
    "test": "npm run build-test && node --test ./dist/test/**/*.js && npm run integration-test",
    "integration-test": "npm run build-test && REDIS_DRIVER=node-redis node --test ./dist/integration-tests/**/*.js && REDIS_DRIVER=ioredis node --test ./dist/integration-tests/**/*.js && REDIS_DRIVER=node-test-driver node --test ./dist/integration-tests/**/*.js",
    "docker-local": "docker build -f ./Dockerfile -t notification-hub-svc:local .",
    "coverage": "c8 --config ./coverage-config.json npm run test",
    "coverage:integration": "c8 --config ./coverage-config.json npm run integration-test",
    "docker-api": "docker build -f ./api-tests/rest-wrapper/dockerfile -t rest-wrapper-svc:local .",
    "api": "npm run build-test && node ./dist/api-tests/rest-wrapper/rest-wrapper.js",
    "docker-api:run": "npm run docker-api && docker run -p 8080:8080 -p 8081:8081 rest-wrapper-svc:local",
    "k6": "npm run build-test && K6_OTEL_GRPC_EXPORTER_INSECURE=true K6_OTEL_METRIC_PREFIX=k6_ K6_OTEL_GRPC_EXPORTER_ENDPOINT=localhost:4317 k6 run --tag test-id=123 -o opentelemetry ./dist/api-tests/seq-single-write-range-read-tests.js",
    "saturation:diagnose": "npm run build-test && node ./dist/api-tests/diagnose-saturation.js",
    "saturation:diagnose:help": "npm run build-test && node ./dist/api-tests/diagnose-saturation.js --help",
    "saturation:find": "npm run build-test && node ./dist/api-tests/find-saturation.js",
    "saturation:find:help": "npm run build-test && node ./dist/api-tests/find-saturation.js --help"
  },
  "keywords": [],
  "author": "Laukik",
  "license": "Apache-2.0",
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/host-metrics": "^0.38.3",
    "@opentelemetry/instrumentation": "^0.213.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@types/k6": "^1.6.0",
    "@types/node": "^25.3.3",
    "@types/sinon": "^21.0.0",
    "bullmq": "^5.71.0",
    "bullmq-otel": "^1.3.0",
    "c8": "^11.0.0",
    "copyfiles": "^2.4.1",
    "dotenv": "^17.3.1",
    "express-service-bootstrap": "^0.18.0",
    "ioredis": "^5.10.0",
    "redis": "^4.7.1",
    "rimraf": "^6.1.3",
    "sinon": "^21.0.1",
    "testcontainers": "^11.12.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "redis-abstraction": "^2.0.13"
  }
}