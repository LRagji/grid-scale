<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
    <!-- Default filesystem configuration -->
    <property>
        <name>fs.defaultFS</name>
        <value>hdfs://hdfs-name-node:9000</value>
    </property>

    <!-- WebHDFS configuration -->
    <property>
        <name>hadoop.http.staticuser.user.name</name>
        <value>hadoop</value>
    </property>

    <!-- Enable proxy user for WebHDFS -->
    <property>
        <name>hadoop.proxyuser.hadoop.hosts</name>
        <value>*</value>
    </property>

    <property>
        <name>hadoop.proxyuser.hadoop.groups</name>
        <value>*</value>
    </property>
</configuration>
